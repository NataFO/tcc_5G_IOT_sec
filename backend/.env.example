# Copie este arquivo para ".env" (na pasta backend/) e preencha com os dados
# do seu PostgreSQL local. O arquivo .env NÃO deve ser commitado (já está no
# .gitignore do projeto).

DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# Usada para assinar os tokens JWT do /auth/login. Pode deixar um valor
# qualquer para desenvolvimento local.
SECRET_KEY=chave-secreta-tcc-5g-2026
